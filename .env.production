# Service Network Binding (Local loopback only - never expose 3001 to public)
PORT=3001
HOST=127.0.0.1
NODE_ENV=production

# MySQL Database Connection (Hostinger MySQL)
# Note: In Hostinger hPanel -> Databases -> MySQL Databases
# Create database (e.g., u641431622_gym) and user (e.g., u641431622_gymadmin)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=u641431622_gymadmin
DB_PASS=REPLACE_WITH_YOUR_HOSTINGER_MYSQL_PASSWORD
DB_NAME=u641431622_gym
DB_CONNECTION_LIMIT=5

# Administrative API Authentication Secret
# (Must match whatsapp_worker_secret in the PHP settings table)
WORKER_SECRET=0649e770e7ec8b31b32d6f6c2c8e21c346a36762f390406f9f57a0e9bae9a708

# Operational Safety Guardrails
# Set DRY_RUN_MODE=true initially to verify QR pairing without sending real messages
DRY_RUN_MODE=true
EXPERIMENTAL_DISPATCH_ENABLED=false

# Timezone & Scheduling (Indian Standard Time for Mumbai Server)
TIMEZONE=Asia/Kolkata
SCHEDULER_CRON=0 * * * *
SCHEDULER_INTERVAL_MINUTES=60
QUEUE_POLL_INTERVAL_SECONDS=10

# Anti-Flood Jitter Delays (8-15 seconds per message)
DISPATCH_DELAY_MIN_MS=8000
DISPATCH_DELAY_MAX_MS=15000
MAX_RETRY_ATTEMPTS=3

# Logging Configuration
LOG_LEVEL=info
