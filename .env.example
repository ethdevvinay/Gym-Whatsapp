# THE CLUB 777° — Node.js WhatsApp Reminder Worker Environment Configuration
# Copy this file to .env and configure values for your deployment environment.

# Service Network Binding
PORT=3001
HOST=127.0.0.1

# MySQL Database Connection (Use least-privilege user in production)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=gym_db
DB_CONNECTION_LIMIT=5

# Administrative API Authentication Secret (Must match whatsapp_worker_secret in settings table)
WORKER_SECRET=0649e770e7ec8b31b32d6f6c2c8e21c346a36762f390406f9f57a0e9bae9a708

# Operational Safety Guardrails
# Set DRY_RUN_MODE=true to simulate queue processing without sending live network packets
DRY_RUN_MODE=true
# Set EXPERIMENTAL_DISPATCH_ENABLED=false to require admin toggle before real socket sends
EXPERIMENTAL_DISPATCH_ENABLED=false

# Timezone & Scheduling
TIMEZONE=Asia/Kolkata
SCHEDULER_CRON=0 * * * *
SCHEDULER_INTERVAL_MINUTES=60
QUEUE_POLL_INTERVAL_SECONDS=10

# Safe Queue Rate Throttling & Jitter (Milliseconds)
DISPATCH_DELAY_MIN_MS=8000
DISPATCH_DELAY_MAX_MS=15000
MAX_RETRY_ATTEMPTS=3

# Logging Level: debug, info, warn, error, silent
LOG_LEVEL=info
